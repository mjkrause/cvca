# Example configuration for the chatbot proxy.
#
# Copy this file to ~/.config/cvca-chatbot/env, fill in your own values,
# and lock down its permissions:
#
#   cp env.example ~/.config/cvca-chatbot/env
#   chmod 600 ~/.config/cvca-chatbot/env
#
# Do NOT commit your real ~/.config/cvca-chatbot/env anywhere — it holds
# your live API key.

# Your Anthropic API key. Get one at https://console.anthropic.com
# Required — the proxy refuses to start without a key shaped like sk-ant-...
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Absolute path to the node binary to run. If node was installed with nvm,
# there is no fixed location — find yours with: command -v node
# Linux home directories look like /home/YOUR_USER; on macOS it's /Users/YOUR_USER.
NODE_BIN=/home/YOUR_USER/.nvm/versions/node/vXX.X.X/bin/node

# Absolute path to this chatbot's checkout on this machine.
PROJECT_DIR=/home/YOUR_USER/dev/cvca/chatbot

# Network settings the proxy listens on. Defaults shown below are used by
# proxy.js if these are omitted, so you can delete either line if the
# default is fine.
PORT=3000
HOST=127.0.0.1

# Comma-separated list of origins allowed to call POST /v1/messages.
# Defaults to http://localhost:$PORT,http://127.0.0.1:$PORT if omitted —
# only change this if you serve the chatbot HTML from somewhere else.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
